        "        self.pi_k = math.pi + delta_k\n",
        "        return delta_k\n",
        "\n",
        "    def colapsar_conjunto_p_menos_1(self, n, delta_k):\n",
        "        \"\"\"\n",
        "        P-1 (A Necessidade Improvável):\n",
