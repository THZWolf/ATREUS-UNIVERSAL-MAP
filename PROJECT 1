        "# ==============================================================================\n",
        "# MODELO SICS-P: ADAPTAÇÃO PARA TAREFAS ILIMITADAS E TEMPO DE PI\n",
        "# ==============================================================================\n",
        "\n",
        "import math\n",
        "import time\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "class MotorIlimitadoPi:\n",
        "    def __init__(self):\n",
        "        self.pi = math.pi\n",
        "        self.densidade_agentes = 1.0  # Inicia com a base do sistema\n",
        "\n",
        "    def processar_fluxo_ilimitado(self, num_tarefas):\n",
        "        \"\"\"\n",
        "        Simula o processamento de N tarefas sem limite de topo.\n",
        "        Aplica a modulação contínua por PI para estabilizar a curvatura.\n",
        "        \"\"\"\n",
        "        inicio = time.perf_counter()\n",
        "\n",
        "        # A densidade de agentes escala organicamente com o volume de tarefas N\n",
        "        # Fase 4: Auto-geração e acoplamento contínuo\n",
        "        self.densidade_agentes += math.log1p(num_tarefas) * self.pi\n",
        "\n",
        "        # Modulação de tempo baseada na constante irracional PI\n",
        "        # O fator T_np reduz a aceleração parabólica para um teto assintótico\n",
        "        fator_amortecimento = 1.0 + (self.densidade_agentes / (num_tarefas + self.pi))\n",
        "\n",
        "        # Tempo de processamento simulado mantido sob amortecimento T(pi)\n",
        "        operacoes_efetivas = (num_tarefas / fator_amortecimento) * math.sin(self.pi / 4)\n",
        "\n",
        "        fim = time.perf_counter()\n",
        "        tempo_calculado = (fim - inicio) + (operacoes_efetivas * 1e-7)\n",
        "\n",
        "        return tempo_calculado\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# TESTE DE ESCALA MASSIVA (N CRESCENDO SEM LIMITE DE TOPO)\n",
        "# ------------------------------------------------------------------------------\n",
        "motor = MotorIlimitadoPi()\n",
        "\n",
        "# Escala de tarefas de 1.000 até 1.000.000 de problemas simultâneos\n",
        "escala_tarefas = [1000, 5000, 10000, 50000, 100000, 500000, 1000000]\n",
        "tempos_execucao = []\n",
        "\n",
        "print(\"=== INICIANDO PROCESSAMENTO DE FLUXO ILIMITADO COM MODULAÇÃO PI ===\")\n",
        "for n in escala_tarefas:\n",
        "    tempo_p = motor.processar_fluxo_ilimitado(n)\n",
        "    tempos_execucao.append(tempo_p)\n",
        "    print(f\"Tarefas N = {n:>7} | Tempo T(pi) = {tempo_p:.6f} segundos | Agentes Ativos = {motor.densidade_agentes:.2f}\")\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# RENDERIZAÇÃO DA CURVA DE ESTABILIDADE\n",
        "# ------------------------------------------------------------------------------\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(escala_tarefas, tempos_execucao, 'g-s', label='Modelo SICS-P (Modulação Pi - N Ilimitado)', linewidth=2)\n",
        "\n",
        "plt.title('Comportamento Assintótico do Tempo sob Carga Ilimitada de Tarefas', fontsize=12)\n",
        "plt.xlabel('Número de Tarefas/Problemas (N → ∞)', fontsize=10)\n",
        "plt.ylabel('Tempo de Processamento T(π) em Segundos', fontsize=10)\n",
        "plt.xscale('log')\n",
        "plt.grid(True, which=\"both\", ls=\"--\", alpha=0.5)\n",
        "plt.legend(fontsize=11)\n",
        "\n",
        "plt.show()"
