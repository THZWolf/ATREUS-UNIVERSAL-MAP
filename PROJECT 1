        "# ==============================================================================\n",
        "# MODELO SICS-P: VARIÁVEL PI EXPANSIVA COM PRIMOS PARES INTEIROS POSITIVOS\n",
        "# Autor: Gabriel Rodrigues de Andrade Salles\n",
        "# ==============================================================================\n",
        "\n",
        "import math\n",
        "import time\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def eh_primo(n):\n",
        "    \"\"\"Verifica se um número é primo.\"\"\"\n",
        "    if n < 2:\n",
        "        return False\n",
        "    for i in range(2, int(math.isqrt(n)) + 1):\n",
        "        if n % i == 0:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "def gerar_proximo_primo(ultimo_primo):\n",
        "    \"\"\"Gera o próximo número primo após o valor fornecido.\"\"\"\n",
        "    candidato = ultimo_primo + 1\n",
        "    while not eh_primo(candidato):\n",
        "        candidato += 1\n",
        "    return candidato\n",
        "\n",
        "class MotorPiExpansivoPrimoPar:\n",
        "    def __init__(self):\n",
        "        self.pi_base = math.pi\n",
        "        self.ultimo_primo = 1  # O primeiro primo gerado será 2\n",
        "        self.ciclo_k = 0\n",
        "        self.densidade_agentes = 1.0\n",
        "\n",
        "    def calcular_nova_variavel_pi(self):\n",
        "        \"\"\"\n",
        "        REGRA APLICADA:\n",
        "        A cada ciclo, gera uma nova variável derivada de PI somando um número primo.\n",
        "        Aplica o ajuste (+1 se ímpar) para garantir que a variação seja SEMPRE:\n",
        "        - Inteira\n",
        "        - Positiva\n",
        "        - PAR (nunca ímpar)\n",
        "        - Nunca negativa ou fracionária.\n",
        "        \"\"\"\n",
        "        self.ciclo_k += 1\n",
        "        p_k = gerar_proximo_primo(self.ultimo_primo)\n",
        "        self.ultimo_primo = p_k\n",
        "\n",
        "        # Ajuste para garantir paridade par estrita\n",
        "        if p_k % 2 != 0:\n",
        "            delta_k = p_k + 1  # Ímpar + 1 = Par Inteiro Positivo\n",
        "        else:\n",
        "            delta_k = p_k      # O único primo par é 2 (já é Par Inteiro Positivo)\n",
        "\n",
        "        # Validação estrita das restrições\n",
        "        assert delta_k > 0, \"Erro: Valor deve ser positivo.\"\n",
        "        assert isinstance(delta_k, int), \"Erro: Valor deve ser inteiro (sem frações).\"\n",
        "        assert delta_k % 2 == 0, \"Erro: Valor NUNCA pode ser ímpar.\"\n",
        "\n",
        "        pi_k = self.pi_base + delta_k\n",
        "        return pi_k, delta_k, p_k\n",
        "\n",
        "    def processar_ciclo_ilimitado(self, num_tarefas):\n",
        "        \"\"\"Processa um ciclo de tarefas aplicando a nova variável PI_k do ciclo.\"\"\"\n",
        "        inicio = time.perf_counter()\n",
        "\n",
        "        # Gera a nova variável PI_k aplicando as regras estritas\n",
        "        pi_k, delta_k, primo_utilizado = self.calcular_nova_variavel_pi()\n",
        "\n",
        "        # Injeção de densidade de agentes regulada por PI_k\n",
        "        self.densidade_agentes += math.log1p(num_tarefas) * pi_k\n",
        "\n",
        "        # Amortecimento do tempo T(N, k)\n",
        "        fator_amortecimento = 1.0 + (self.densidade_agentes / (num_tarefas + pi_k))\n",
        "        operacoes_efetivas = (num_tarefas / fator_amortecimento) * abs(math.sin(pi_k / 4))\n",
        "\n",
        "        fim = time.perf_counter()\n",
        "        tempo_calculado = (fim - inicio) + (operacoes_efetivas * 1e-7)\n",
        "\n",
        "        return tempo_calculado, pi_k, delta_k, primo_utilizado\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# TESTE DE EXECUÇÃO MULTI-CICLO COM A REGRA PRIMO-PAR APLICADA\n",
        "# ------------------------------------------------------------------------------\n",
        "motor = MotorPiExpansivoPrimoPar()\n",
        "escala_tarefas = [1000, 5000, 10000, 50000, 100000, 500000, 1000000]\n",
        "\n",
        "tempos = []\n",
        "variaveis_pi = []\n",
        "\n",
        "print(\"=== INICIANDO SIMULAÇÃO SICS-P COM REGRA EXPANSIVA DE PI (PRIMO-PAR INTEIRO POSITIVO) ===\")\n",
        "print(f\"{'Ciclo k':<8} | {'Tarefas N':<10} | {'Primo p_k':<10} | {'Delta_k (PAR)':<14} | {'Variável Pi_k':<16} | {'Tempo T(N,k)':<12}\")\n",
        "print(\"-\" * 80)\n",
        "\n",
        "for n in escala_tarefas:\n",
        "    tempo_p, pi_k, delta_k, primo = motor.processar_ciclo_ilimitado(n)\n",
        "    tempos.append(tempo_p)\n",
        "    variaveis_pi.append(pi_k)\n",
        "    print(f\"{motor.ciclo_k:<8} | {n:<10} | {primo:<10} | {delta_k:<14} | {pi_k:<16.5f} | {tempo_p:.6f}s\")\n",
        "\n",
        "# ------------------------------------------------------------------------------\n",
        "# RENDERIZAÇÃO DO GRÁFICO DE ESTABILIDADE DA VARIÁVEL PI_K\n",
        "# ------------------------------------------------------------------------------\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(range(1, len(escala_tarefas) + 1), variaveis_pi, 'b-o', label='Evolução da Variável $\\pi_k$ (Primo-Par Positivo Inteiro)', linewidth=2)\n",
        "\n",
        "plt.title('Expansão da Variável $\\pi_k$ por Ciclo com Garantia de Paridade Par', fontsize=12)\n",
